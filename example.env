# ==============================================================================
# ENTERPRISE MULTI-VENDOR MARKETPLACE - ENVIRONMENT CONFIGURATION TEMPLATE
# Rename this file to .env for local overrides (never commit .env to git)
# ==============================================================================

# Application Profiles & Server
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
API_BASE_URL=http://localhost:8080/api/v1
APP_FRONTEND_URL=http://localhost:3000

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketplace_db
DB_USER=marketplace_user
DB_PASSWORD=your_db_password_here
DB_POOL_SIZE=20

# Redis Cache & Distributed Locking
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# JWT & Security
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_base64_encoded_here
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800
MFA_ISSUER=EnterpriseMarketplace

# Message Broker (RabbitMQ)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=marketplace_rabbit
RABBITMQ_PASSWORD=your_rabbitmq_password_here

# Object Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=marketplace-assets
S3_ACCESS_KEY=your_minio_access_key
S3_SECRET_KEY=your_minio_secret_key
S3_REGION=us-east-1

# Payment Gateway (Stripe Sandbox / Test)
STRIPE_API_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret

# Email Service (SMTP / SendGrid)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_FROM=support@enterprisemarketplace.com
